# ─── Herald Release Concierge — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── AI / Reasoning (at least one required) ──────────────────────────────────

# ── Tier 1: Foundry Agent (thread/run/poll — primary) ────────────────────────
# Create agents in Foundry UI → Build → Agents, then paste the agent ID from Details tab.
# Project endpoint: Foundry UI → your project → Settings → Project endpoint
# IMPORTANT: The Agents API authenticates with Entra ID (RBAC), NOT the API key. Herald uses DefaultAzureCredential.
# Run `az login` locally (account needs "Azure AI User"/"Foundry User" on the resource) or use managed identity in Azure. Agent id must be the asst_... id from Foundry UI → Agents → Details.
FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"
FOUNDRY_AGENT_ID="YOUR_AGENT_ID"

# ── Tier 2: Phi-4 via Azure AI Inference (fallback) ──────────────────────────
# Inference endpoint: Foundry UI → Build → Deployments → your model deployment → endpoint
# Use the same FOUNDRY_API_KEY — no extra key needed.
# Must include /openai/v1 so the client can append /chat/completions correctly.
# IMPORTANT: Use an instruction-following model (Phi-4-mini-instruct or gpt-4o-mini),
# NOT Phi-4-reasoning (a thinking model that loops infinitely on structured JSON tasks).
FOUNDRY_INFERENCE_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/openai/v1"
FOUNDRY_INFERENCE_DEPLOYMENT="Phi-4-mini-instruct"

# ── Tier 3: Azure OpenAI / gpt-4o (fallback when quota available) ────────────
# Full endpoint URL from your Azure AI hub, e.g. https://my-resource.openai.azure.com
# Herald tries the classic /openai/deployments/{name} path first, then /openai/v1 (AI Foundry serverless).
FOUNDRY_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com"
FOUNDRY_API_KEY="YOUR_FOUNDRY_API_KEY"
# Name of your deployed model — must be deployed in Foundry UI → Build → Deployments
# Recommended: gpt-4o-mini (free tier available, better JSON compliance than reasoning models)
FOUNDRY_DEPLOYMENT="gpt-4o-mini"

# ── Tier 4: Google Gemini (fallback) ─────────────────────────────────────────
# Free key at https://aistudio.google.com/apikey
# Free tier: ~1500 requests/day, 15 RPM. If you hit quota, wait 24h or upgrade.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Model to use — gemini-2.5-flash is the default (2.0-era models have no free-tier quota).
GEMINI_MODEL="gemini-2.5-flash"

# ── Microsoft Graph / M365 enterprise actions ────────────────────────────────

# Azure App Registration (Entra ID) — service principal for Graph API
GRAPH_TENANT_ID="YOUR_TENANT_ID"
GRAPH_CLIENT_ID="YOUR_APP_CLIENT_ID"
GRAPH_CLIENT_SECRET="YOUR_APP_CLIENT_SECRET"

# Teams: target team + channel for release announcements
TEAMS_TEAM_ID="YOUR_TEAMS_TEAM_ID"
TEAMS_CHANNEL_ID="YOUR_TEAMS_CHANNEL_ID"

# SharePoint: site + list IDs for the release log
SHAREPOINT_SITE_ID="YOUR_SHAREPOINT_SITE_ID"
SHAREPOINT_LIST_ID="YOUR_SHAREPOINT_LIST_ID"

# Outlook: UPN or user ID that creates rollout calendar reminders
OUTLOOK_USER_ID="YOUR_USER_ID_OR_UPN"

# ── GitHub webhook ────────────────────────────────────────────────────────────

# Shared secret configured in GitHub repo Settings → Webhooks → Secret
# Leave empty in dev to skip signature verification
GITHUB_WEBHOOK_SECRET="YOUR_GITHUB_WEBHOOK_SECRET"

# GitHub Personal Access Token (classic or fine-grained, repo read scope)
# Required for real diff/file fetching from private repos.
# Public repos: leave empty — heuristic fallback is used instead.
GITHUB_TOKEN="YOUR_GITHUB_PAT"

# ── GitHub Copilot Extension (Creative Apps track) ────────────────────────────
# Register Herald as a GitHub App with Copilot Extension capabilities:
#   1. github.com → Settings → Developer settings → GitHub Apps → New GitHub App
#   2. Enable "Copilot Extension" and set Callback URL to: https://YOUR_APP_URL/copilot
#   3. Install the app on your org/repo
#   4. Users type `@herald <command>` in GitHub Copilot Chat
# See: https://docs.github.com/en/copilot/building-copilot-extensions
#
# In local dev/testing, set this to bypass RSA signature verification:
COPILOT_SKIP_SIG_VERIFY=1

# ── Work IQ — M365 calendar signals ──────────────────────────────────────────
# When set, Work IQ remaps team member UPNs from the bundled @cloudnexus.io
# domain to your organisation's actual tenant domain at runtime.
# Set to your M365 tenant domain, e.g. "contoso.com" or "mycompany.onmicrosoft.com".
# Leave unset to use the synthetic signals from data/team-certifications.json.
# TENANT_DOMAIN="contoso.com"

# ── App config ────────────────────────────────────────────────────────────────

# Port for the Express server (default: 3000)
PORT="3000"

# Public URL of this service — used for webhook registration and self-links
APP_URL="https://YOUR_APP_URL"

# Set to "production" to serve the Vite build instead of the dev server
NODE_ENV="development"
